# Supabase — completar en .env.local (NUNCA commitear .env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. JAMÁS exponer al browser ni prefijar con NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Backup diario (cron de Vercel): si está, la ruta /api/backup exige Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Integración Wix (app custom creada en manage.wix.com/account/custom-apps e instalada en el sitio)
WIX_APP_ID=
WIX_APP_SECRET=
WIX_INSTANCE_ID=
# Clave pública de la app (Webhooks → Public key), con los saltos de línea como \n
WIX_PUBLIC_KEY=
# Secreto propio para /api/wix/sync (cron de reconciliación): Authorization: Bearer <WIX_SYNC_SECRET>
WIX_SYNC_SECRET=
# Opcional: id del sitio para linkear cada pedido al panel de Wix
WIX_SITE_ID=
